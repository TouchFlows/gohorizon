{
    "name": "gohorizon/laravel-e2e-fixture",
    "description": "Disposable Laravel application the GoHorizon acceptance tests supervise.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "gohorizon/laravel": "@dev",
        "laravel/framework": "^13.0",
        "predis/predis": "^2.3 || ^3.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../../packages/laravel",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    }
}
