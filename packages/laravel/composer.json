{
    "name": "gohorizon/laravel",
    "description": "Laravel 13 adapter for GoHorizon: lifecycle telemetry, capabilities and queue inspection.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/queue": "^13.0",
        "illuminate/redis": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "GoHorizon\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GoHorizon\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "GoHorizon\\Laravel\\GoHorizonServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
